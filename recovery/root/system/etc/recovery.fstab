/dev/block/mmcblk0boot0                  /spl                emmc    defaults slotselect
/dev/block/mmcblk0boot1                  /spl_bk             emmc    defaults defaults
/dev/block/by-name/uboot                 /uboot              emmc    defaults slotselect
/dev/block/by-name/sml                   /sml                emmc    defaults slotselect
/dev/block/by-name/trustos               /tos                emmc    defaults slotselect
/dev/block/by-name/teecfg                /teecfg             emmc    defaults slotselect
system                                   /system             ext4    ro wait,avb=vbmeta_system,logical,first_stage_mount,slotselect
vendor                                   /vendor             erofs   ro wait,avb=vbmeta_vendor,logical,first_stage_mount,slotselect
vendor_dlkm                              /vendor_dlkm        erofs   ro wait,avb=vbmeta_system_ext,logical,first_stage_mount,slotselect

/dev/block/mmcblk1p1                     /external_sd        auto    defaults     defaults
/dev/block/sdd1                          /usb_otg            auto    defaults     defaults

# userdata
/dev/block/by-name/userdata              /data               f2fs    defaults     wait,check,formattable
/dev/block/by-name/userdata              /data               ext4    defaults     wait,check,formattable
/dev/block/by-name/misc                  /misc               emmc    defaults     defaults
/dev/block/by-name/metadata              /metadata           f2fs    defaults     wait
/dev/block/by-name/cache                 /cache              f2fs    defaults     wait